# Port on which the server will run
PORT=3000

# Secure passcode for parents to access the portal
SHARED_PASSWORD=camp2026

# Secure passcode for admins to edit and delete files
ADMIN_PASSWORD=admin2026

# Google Drive folder ID containing the summer camp photos and videos
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Use ONE of the following auth methods:
# -------------------------------------------------------------
# OPTION A: Google Service Account JSON path (Recommended)
# Create a Service Account in Google Cloud, download the JSON key, 
# place it in the project directory, and link to it here.
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json

# OPTION B: Google API Key (Alternative)
# If the folder is shared publicly ("Anyone with the link can view"), 
# you can use an API key. 
# GOOGLE_API_KEY=your_google_api_key_here
